# Copy to .env and fill in real values. Never commit .env itself.

# Secret used to sign JWT session tokens. Generate a long random string for prod.
JWT_SECRET=change-me-to-a-long-random-string

# MySQL connection string (used by Drizzle and the server).
# In the docker-compose dev setup this is set automatically by the api service.
# DATABASE_URL=mysql://root:rootpw@localhost:3306/grocery
